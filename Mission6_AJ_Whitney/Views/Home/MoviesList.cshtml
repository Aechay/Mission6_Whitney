
@{
    ViewData["Title"] = "Movies List";
}
<h1>Movies List</h1>
<table class="table table-hover">
    <thead class="fw-bold">
    <tr>
        <td>Title</td>
        <td>Year</td>
        <td>Category</td>
        <td>Director</td>
        <td>Rating</td>
        <td>Edited</td>
        <td>Lent to</td>
        <td>Copied to Plex</td>
        <td>Notes</td>
        <td>Edit</td>
        <td>Delete</td>
    </tr>
    </thead>
    
    @foreach (var x in ViewBag.Movies)
    {
        <tbody>
        <tr>
            <td>@x.Title</td>
            <td>@x.Year</td>
            <td>@x.Category.CategoryName</td>
            <td>@x.Director</td>
            <td>@x.Rating</td>
            <td>@x.Edited</td>
            <td>@x.LentTo</td>
            <td>@x.CopiedToPlex</td>
            <td>@x.Notes</td>
            <td><a asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId" class="btn btn-primary">Edit</a></td>
            <td><a asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId" class="btn btn-danger">Delete</a></td>
        </tr>
        </tbody>
    }
    
</table>