@model Movie
<div>
    <h2>Confirm Delete</h2>
    <h4>Are you sure you want to delete @Model.Title (@Model.Year)?</h4>
    <form method="post">
        <input hidden readonly asp-for="MovieId"></input>
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Home" asp-action="MoviesList" class="btn btn-secondary">Cancel</a>
    </form>
</div>